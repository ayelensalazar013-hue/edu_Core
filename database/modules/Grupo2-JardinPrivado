CREATE VIEW vista_informe_alumno_tutor AS
SELECT 
    a.ID_Alumno,
    CONCAT(a.Nombre, ' ', a.Apellido) AS Alumno,
    CONCAT(t.Nombre, ' ', t.Apellido) AS Tutor,
    at.Relacion_alumno AS Parentesco,
    ce.Email,
    ce.Tipo_Correo
FROM ALUMNO a
JOIN ALUMNO_TUTOR at ON a.ID_Alumno = at.ID_Alumno
JOIN TUTOR t ON at.ID_Tutor = t.ID_Tutor
LEFT JOIN CORREO_ELECTRONICO ce ON t.ID_Tutor = ce.ID_Tutor;
